{
  "openapi": "3.0.1",
  "info": {
    "title": "MangaFind API",
    "version": "1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Healthy"
          }
        }
      }
    },
    "/identify": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "images": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Identification response"
          },
          "400": {
            "description": "Invalid image"
          },
          "501": {
            "description": "Not implemented"
          }
        }
      }
    }
  }
}
